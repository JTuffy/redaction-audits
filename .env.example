# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Hugging Face read token, for gated source data (scripts/fetch_sources.py).
HF_TOKEN=

# Model per role (Inspect model strings). Defaults live in infra/settings.py.
# REDACTION_ADVOCATE_MODEL=anthropic/claude-sonnet-5-5
# REDACTION_EXECUTOR_MODEL=anthropic/claude-sonnet-5-5
# REDACTION_JUDGE_MODEL=openai/gpt-5.6-terra
# REDACTION_INTEGRITY_CHECK_MODEL=anthropic/claude-haiku-5-5

# Reasoning effort per role: none|minimal|low|medium|high. Part of the frozen protocol.
# REDACTION_ADVOCATE_REASONING=low
# REDACTION_EXECUTOR_REASONING=low
# REDACTION_JUDGE_REASONING=low
# REDACTION_INTEGRITY_CHECK_REASONING=none

# Output locations.
# REDACTION_INSPECT_LOG_DIR=logs/inspect
# REDACTION_RESULTS_DIR=results
# REDACTION_SCENARIOS_DIR=data/generated

# Logging: level and console|json.
# REDACTION_LOG_LEVEL=INFO
# REDACTION_LOG_FORMAT=console

# Public site (docs/publishing.md). Nothing is pushed until PUBLISH_ON_UPDATE is true or
# `redaction deploy --push` is run.
# REDACTION_PUBLIC_TARGET=pages            # pages | firebase
# REDACTION_PUBLIC_REPO=https://github.com/<owner>/redaction-audits-site.git
# REDACTION_FIREBASE_PROJECT=
# REDACTION_PUBLISH_ON_UPDATE=false
