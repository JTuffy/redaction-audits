# Copy to .env and fill in. .env is git-ignored.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Hugging Face read token, for gated source data (scripts/fetch_sources.py).
HF_TOKEN=

# Model per role (Inspect model strings). Defaults live in infra/settings.py.
# REDACTION_ADVOCATE_MODEL=anthropic/claude-sonnet-5-5
# REDACTION_EXECUTOR_MODEL=anthropic/claude-sonnet-5-5
# REDACTION_JUDGE_MODEL=openai/gpt-5.6-terra
# REDACTION_INTEGRITY_CHECK_MODEL=anthropic/claude-haiku-5-5

# Output locations.
# REDACTION_INSPECT_LOG_DIR=logs/inspect
# REDACTION_RESULTS_DIR=results
# REDACTION_SCENARIOS_DIR=data/generated

# Logging: level and console|json.
# REDACTION_LOG_LEVEL=INFO
# REDACTION_LOG_FORMAT=console
